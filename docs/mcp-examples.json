  {"tool": "doc_import", "args": {"path": "${corpus}/poi/missing.pub"}, "expect_error": "file_not_found", "note": "The file does not exist."},
  {"tool": "doc_import", "args": {"path": "${corpus}/NOTICE"}, "expect_error": "invalid_file", "note": "Not a Publisher file: the error says why."},
  {"tool": "doc_close", "args": {"doc_id": "${imported.doc_id}", "confirm": true}},
  {"tool": "doc_new", "args": {"title": "Proof"}, "as": "proof"},
  {"tool": "frame_add_text", "args": {"page_id": "${proof.page_ids.0}", "x": 72, "y": 72, "width": 360, "height": 144, "text": "Fresh bread and pastreis every mornng, typeset with pubrs.\nUne baguette, s'il vous plaît."}, "as": "prooftext"},
  {"tool": "text_apply_para_style", "args": {"frame_id": "${prooftext.frame_id}", "start": 59, "end": 60, "language": "fr-FR"}, "note": "The second paragraph is French."},
  {"tool": "spell_check", "args": {"frame_id": "${prooftext.frame_id}"}, "note": "Misspelt words with story offsets. The French paragraph has no dictionary (only en_US is built in), so it is skipped and listed in unchecked_languages."},
  {"tool": "spell_suggest", "args": {"word": "mornng", "language": "en-US"}},
  {"tool": "spell_suggest", "args": {"word": "chaton", "language": "fr-FR"}, "expect_error": "not_found", "note": "No dictionary for French: add fr_FR.dic and fr_FR.aff to the dictionaries folder."},
  {"tool": "spell_add_word", "args": {"word": "pubrs"}, "note": "Without a dictionaries folder (as in this example session) the word lasts for the session; the app and the CLI save it to user-words.txt."},
  {"tool": "spell_check", "args": {}, "note": "The whole document, after adding pubrs."},
  {"tool": "doc_new", "args": {"title": "Copy target"}, "as": "target"},
  {"tool": "frame_copy_to_doc", "args": {"from_doc_id": "${proof.doc_id}", "frame_ids": ["${prooftext.frame_id}"], "to_doc_id": "${target.doc_id}", "page_index": 0, "offset": {"x": 0, "y": 36}}, "note": "Copies frames between two open documents as one undo step in the target: text frames keep their text and chain, pictures bring their image (reused if the target already has the same bytes), groups stay groups. Styles are matched by name (missing ones are added) and swatches the target lacks become their colours."},
  {"tool": "frame_copy_to_doc", "args": {"from_doc_id": "${proof.doc_id}", "frame_ids": ["${prooftext.frame_id}"], "to_doc_id": "${target.doc_id}", "page_index": 3}, "expect_error": "not_found", "note": "page_index counts from 0 in the target document."},
  {"tool": "doc_close", "args": {"doc_id": "${target.doc_id}", "confirm": true}},
  {"tool": "doc_close", "args": {"doc_id": "${proof.doc_id}", "confirm": true}}
]
