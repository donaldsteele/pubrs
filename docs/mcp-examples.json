[
  {"tool": "fonts_list", "args": {}, "note": "Families every document can use without warnings."},
  {"tool": "template_list", "args": {}, "note": "Built-in and user templates with their placeholders."},
  {"tool": "doc_new", "args": {"page_size": {"preset": "letter"}, "bleed": 9, "title": "Spring Fair"}, "as": "doc"},
  {"tool": "doc_info", "args": {"doc_id": "${doc.doc_id}"}},
  {"tool": "doc_list", "args": {}},
  {"tool": "doc_set_page_size", "args": {"preset": "a4", "orientation": "portrait"}},
  {"tool": "doc_set_margins", "args": {"all": 36, "bottom": 54}},
  {"tool": "doc_set_bleed", "args": {"bleed": 9}},
  {"tool": "doc_set_info", "args": {"title": "Spring Fair", "author": "Parish Council"}},
  {"tool": "doc_set_grid", "args": {"spacing": 18, "snap_to_guides": true}},
  {"tool": "page_add", "args": {}, "as": "p2"},
  {"tool": "page_list", "args": {}},
  {"tool": "page_reorder", "args": {"page_id": "${p2.page_id}", "index": 0}},
  {"tool": "page_reorder", "args": {"page_id": "${p2.page_id}", "index": 1}},
  {"tool": "master_create", "args": {"name": "Footer"}, "as": "master"},
  {"tool": "frame_add_shape", "args": {"master_id": "${master.master_id}", "shape": "line", "x": 36, "y": 800, "width": 523, "height": 0, "stroke": "#1E3A5F", "stroke_width": 1}},
  {"tool": "master_apply", "args": {"master_id": "${master.master_id}"}},
  {"tool": "guide_add", "args": {"page_id": "${doc.page_ids.0}", "axis": "vertical", "position": 297.6}, "as": "guide"},
  {"tool": "guide_remove", "args": {"guide_id": "${guide.guide_id}"}},
  {"tool": "frame_add_text", "args": {"page_id": "${doc.page_ids.0}", "x": 36, "y": 36, "width": 523, "height": 90, "text": "# Spring Fair\nSaturday 12 May · Village Green", "markup": true, "color": "#1E3A5F"}, "as": "title"},
  {"tool": "frame_add_shape", "args": {"page_id": "${doc.page_ids.0}", "shape": "rectangle", "x": 36, "y": 132, "width": 523, "height": 4, "fill": "#C2410C"}, "as": "rule"},
  {"tool": "frame_add_image", "args": {"page_id": "${doc.page_ids.0}", "x": 36, "y": 150, "width": 300, "height": 200, "path": "${assets}/bread.jpg"}, "as": "photo"},
  {"tool": "frame_add_image", "args": {"page_id": "${doc.page_ids.0}", "x": 360, "y": 150, "width": 199, "height": 199}, "as": "logo"},
  {"tool": "frame_add_text", "args": {"page_id": "${doc.page_ids.0}", "x": 36, "y": 370, "width": 250, "height": 120, "style": "Body", "text": "Stalls, games and the famous cake competition. Bring the whole family for a day on the green.\nEntry is free. All proceeds go to the church roof fund, which still needs a great deal of help after last winter's storms. Thank you!"}, "as": "body"},
  {"tool": "frame_add_text", "args": {"page_id": "${doc.page_ids.0}", "x": 309, "y": 370, "width": 250, "height": 120, "style": "Body"}, "as": "body2"},
  {"tool": "text_link_frames", "args": {"from_frame_id": "${body.frame_id}", "to_frame_id": "${body2.frame_id}"}},
  {"tool": "text_get", "args": {"frame_id": "${title.frame_id}"}},
  {"tool": "text_overflow_status", "args": {}},
  {"tool": "text_insert", "args": {"frame_id": "${title.frame_id}", "offset": 0, "text": "The "}},
  {"tool": "text_replace_range", "args": {"frame_id": "${title.frame_id}", "start": 0, "end": 4, "text": ""}},
  {"tool": "text_apply_char_style", "args": {"frame_id": "${title.frame_id}", "start": 0, "end": 11, "color": "#C2410C", "font_size": 40}},
  {"tool": "text_apply_para_style", "args": {"frame_id": "${body.frame_id}", "align": "justify", "space_after": 6}},
  {"tool": "text_set_frame_options", "args": {"frame_id": "${body2.frame_id}", "inset": 6, "vertical_align": "top"}},
  {"tool": "text_set", "args": {"frame_id": "${title.frame_id}", "text": "# Spring Fair\nSaturday 12 May · **Village Green**", "markup": true}},
  {"tool": "text_unlink_frames", "args": {"frame_id": "${body.frame_id}"}},
  {"tool": "style_list", "args": {"kind": "paragraph"}},
  {"tool": "style_create", "args": {"name": "Price", "based_on": "Body", "character": {"font_size": 16, "bold": true}}},
  {"tool": "style_update", "args": {"style": "Price", "character": {"color": "#C2410C"}}},
  {"tool": "style_delete", "args": {"style": "Price", "confirm": true}},
  {"tool": "image_crop", "args": {"frame_id": "${photo.frame_id}", "left": 0.1, "right": 0.1}},
  {"tool": "image_fit", "args": {"frame_id": "${photo.frame_id}", "mode": "fill"}},
  {"tool": "image_replace", "args": {"frame_id": "${photo.frame_id}", "path": "${assets}/coffee.png"}},
  {"tool": "image_place", "args": {"frame_id": "${logo.frame_id}", "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='46' fill='#1E3A5F'/><path d='M30 62 L50 30 L70 62 Z' fill='#FFF7ED'/></svg>"}},
  {"tool": "frame_move", "args": {"frame_id": "${rule.frame_id}", "dy": 2}},
  {"tool": "frame_resize", "args": {"frame_id": "${photo.frame_id}", "width": 290}},
  {"tool": "frame_rotate", "args": {"frame_id": "${logo.frame_id}", "degrees": 4}},
  {"tool": "frame_set_zorder", "args": {"frame_id": "${photo.frame_id}", "action": "bring_to_front"}},
  {"tool": "frame_set_style", "args": {"frame_id": "${body2.frame_id}", "fill": "#FFF7ED", "stroke": "#1E3A5F", "stroke_width": 1}},
  {"tool": "frame_set_wrap", "args": {"frame_id": "${logo.frame_id}", "mode": "square", "margin": 6}},
  {"tool": "frame_set_placeholder", "args": {"frame_id": "${title.frame_id}", "name": "headline", "hint": "Event name and date"}},
  {"tool": "frame_lock", "args": {"frame_id": "${rule.frame_id}", "locked": true}},
  {"tool": "frame_lock", "args": {"frame_id": "${rule.frame_id}", "locked": false}},
  {"tool": "frame_align", "args": {"frame_ids": ["${photo.frame_id}", "${logo.frame_id}"], "edge": "top"}},
  {"tool": "frame_distribute", "args": {"frame_ids": ["${photo.frame_id}", "${logo.frame_id}"], "axis": "horizontal", "within": "margins"}},
  {"tool": "frame_group", "args": {"frame_ids": ["${photo.frame_id}", "${logo.frame_id}"]}, "as": "group"},
  {"tool": "frame_ungroup", "args": {"group_id": "${group.group_id}"}},
  {"tool": "frame_duplicate", "args": {"frame_id": "${rule.frame_id}", "dy": 360}, "as": "rule2"},
  {"tool": "frame_delete", "args": {"frame_id": "${rule2.frame_id}", "confirm": true}},
  {"tool": "frame_list", "args": {"kind": "text"}},
  {"tool": "frame_get", "args": {"frame_id": "${photo.frame_id}"}},
  {"tool": "history_list", "args": {}},
  {"tool": "undo", "args": {}},
  {"tool": "redo", "args": {}},
  {"tool": "validate", "args": {}},
  {"tool": "render_preview", "args": {"page_id": "${doc.page_ids.0}", "dpi": 30}},
  {"tool": "export_png", "args": {"page_id": "${doc.page_ids.0}", "dpi": 72, "path": "spring-fair.png"}},
  {"tool": "export_pdf", "args": {"path": "spring-fair.pdf", "crop_marks": true}},
  {"tool": "doc_to_json", "args": {}},
  {"tool": "doc_save", "args": {}, "expect_error": "invalid_argument", "note": "A new document has no path yet: doc_save fails until doc_save_as is used."},
  {"tool": "doc_save_as", "args": {"path": "spring-fair"}, "as": "saved"},
  {"tool": "doc_save", "args": {}},
  {"tool": "page_info", "args": {"page_id": "${doc.page_ids.0}"}},
  {"tool": "template_save", "args": {"name": "spring_fair"}},
  {"tool": "page_delete", "args": {"page_id": "${p2.page_id}", "confirm": true}},
  {"tool": "master_delete", "args": {"master_id": "${master.master_id}", "confirm": true}},
  {"tool": "template_apply", "args": {"name": "flyer", "title": "Bake Sale"}, "as": "flyer"},
  {"tool": "doc_close", "args": {"doc_id": "${flyer.doc_id}", "confirm": true}},
  {"tool": "doc_open", "args": {"path": "${saved.path}"}}
]
