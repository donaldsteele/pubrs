  {"tool": "text_apply_para_style", "args": {"frame_id": "${body.frame_id}", "align": "justify", "hyphenate": true, "language": "en-US", "justify_limits": {}}, "note": "Hyphenation on, and justification limited to the defaults (word spaces up to 133%, then letter spacing up to 5%). Without justify_limits, justification is unbounded as in v0.1; typed soft hyphens (U+00AD) are honoured either way."},
  {"tool": "text_apply_para_style", "args": {"frame_id": "${body.frame_id}", "keep_together": true, "widow_orphan": true}, "note": "Keep each paragraph in one column or frame, and leave at least 2 lines on either side of a break (true = 2 lines; a number sets the lines, false or 0 turns it off). Unset, paragraphs break as in v0.1."},
  {"tool": "text_apply_para_style", "args": {"frame_id": "${body.frame_id}", "start": 0, "end": 0, "drop_cap": {"lines": 3, "chars": 1}}, "note": "A drop cap on the first paragraph: its first letter spans 3 lines, and those lines are indented past it. {\"lines\": 0} removes it."},
  {"tool": "text_insert_break", "args": {"frame_id": "${body.frame_id}", "kind": "frame"}, "note": "A break is one character in the story (column U+000E, frame U+001D, page U+000C). Without an offset it goes at the end, so what follows starts in the next frame of the chain."},
  {"tool": "text_set_tabs", "args": {"frame_id": "${body.frame_id}", "start": 0, "end": 0, "stops": [{"pos": 200, "align": "right", "leader": "dot"}]}, "note": "A right-aligned stop 200 pt from the text edge with a dot leader: \"Soup<TAB>4.50\" fills the gap with dots, and leaders line up from line to line. Align is left (default), center, right or decimal; leader is none (default), dot, dash or line. A tab past the last stop (or with no stops) goes to the next 36 pt."},
  {"tool": "text_set_tabs", "args": {"frame_id": "${body.frame_id}", "start": 0, "end": 0, "stops": []}, "note": "An empty list clears the stops."},
  {"tool": "text_apply_list", "args": {"frame_id": "${body.frame_id}", "start": 0, "end": 0, "kind": "number", "format": "1.", "restart_at": 1}, "note": "Numbered list items with a hanging indent: the number sits 18 pt (indent) left of the text. Numbering continues across paragraphs and linked frames; level 1 items restart after a level 0 item. The label is generated text, not part of the story: text_get shows it as list_label."},
  {"tool": "text_apply_list", "args": {"frame_id": "${body.frame_id}", "start": 0, "end": 0, "kind": "none"}, "expect_error": "invalid_argument", "note": "kind is bullet or number; text_clear_list removes a list."},
