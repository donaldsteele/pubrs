{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(cargo *)",
      "Bash(rustup *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(vulkaninfo *)",
      "Bash(xvfb-run *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(sudo *)"
    ]
  }
}
